{
  "name": "isan-bid-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "seed:import-legacy": "tsx --env-file=.env.local scripts/import-legacy-discovery-seed.ts",
    "seed:fetch-data-go": "tsx --env-file=.env.local scripts/fetch-data-go-discovery-seed.ts",
    "taxonomy:discover": "tsx --env-file=.env.local scripts/discover-taxonomy.ts",
    "sync": "tsx --env-file=.env.local scripts/sync-tenders.ts",
    "sync:rss": "tsx --env-file=.env.local scripts/sync-rss.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
