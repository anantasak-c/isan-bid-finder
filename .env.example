# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.

# Gemini is used during ingestion and only for complex natural-language queries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_TIMEOUT_MS=12000
GEMINI_TAXONOMY_TIMEOUT_MS=120000
GEMINI_TAXONOMY_BATCH_SIZE=150

# Official Data.go.th CKAN resources, comma separated.
DATA_GO_TH_API_KEY=
DATA_GO_TH_BASE_URL=https://data.go.th/api/3/action
DATA_GO_TH_OPEN_TENDER_RESOURCE_IDS=

# Optional private, read-only object used to rebuild taxonomy on each daily run.
# Its content is processed in memory and is never written to production tables.
DISCOVERY_SEED_URL=
DISCOVERY_SEED_BEARER_TOKEN=

# Protects /api/cron/sync. Vercel sends it as a Bearer token.
CRON_SECRET=
SYNC_TIME_ZONE=Asia/Bangkok

# Development only. Production refuses demo data.
ALLOW_DEMO_DATA=true
